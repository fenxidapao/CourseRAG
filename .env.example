# ===== 模型 =====
# 当前 v1.1 口径：嵌入走本机 Ollama bge-m3；生成/裁判走云端 OpenAI 兼容 API。
# 全本地回退：EMBEDDING_MODEL=nomic-embed-text + PERSIST_DIRECTORY=./chroma_db
#             + LLM_PROVIDER=ollama / LLM_MODEL=llama3.1:8b
#             + JUDGE_PROVIDER=local / JUDGE_MODEL=qwen2.5:7b（须重建索引）
EMBEDDING_MODEL=bge-m3
# 生成模型：provider=ollama 时填 Ollama 模型名；provider=openai 时填云端模型名
LLM_MODEL=deepseek-v4.1-flash
OLLAMA_BASE_URL=http://localhost:11434
# 本地模型上下文窗口：不设时 Ollama 默认 4096，8 块上下文会被静默截断（实测 8192 才稳定）
OLLAMA_NUM_CTX=8192
LLM_TEMPERATURE=0.2

# ===== 生成 provider（C3 去本地化，2026-10-15）=====
# openai = OpenAI 兼容云端生成（当前默认，走 LLM_API_BASE）
# ollama = 切回本地生成（需本机模型；8 GB 显存下与本地裁判同开可能挂住 CUDA，
#          Windows WDDM 不报 OOM，表现为日志长时间无输出、CPU 仍上涨）
LLM_PROVIDER=openai
# 云端 OpenAI 兼容接口（仅 LLM_PROVIDER=openai 时使用）
LLM_API_BASE=https://kuaipao.pro/v1
# 云端 key：留空时自动尝试环境变量 LLM_API_KEY / KUAIPAO_API_KEY，
# 再尝试 ~/.dsh/.credentials.yaml 的 KUAIPAO_API_KEY；**不要把真实 key 写进仓库**。
# LLM_API_KEY=sk-xxxx
# 推理模型预算：deepseek-v4.1-flash 实测 max_tokens=256 时全部耗在 reasoning、
# content 为空；故默认 2048，并在空 content+reasoning 占满时自动翻倍到 cap。
LLM_TIMEOUT=180
LLM_MAX_TOKENS=2048
LLM_MAX_TOKENS_CAP=8192

# ===== 切分 / 路径 =====
# 注意：与 config 默认及实际评估基线一致（CHUNK_SIZE=800 / CHUNK_OVERLAP=150，
# 全部 A/B 与 held-out 数字在此配置下测得；勿改回 500/80 以免与评估证据脱节）
CHUNK_SIZE=800
CHUNK_OVERLAP=150
DATA_DIR=./data
# 当前库是 bge-m3 索引（1434 块）；全本地 nomic 回退时改为 ./chroma_db
PERSIST_DIRECTORY=./chroma_db_m3

# ===== 论文库（v2.1，APP_PROFILE=paper 时生效）=====
# paper=论文库（默认，paper_rag）；course=v1.1 课程版（归档在 tag/branch 上）
APP_PROFILE=paper
PAPERS_DIR=./data/papers
PAPERS_RAW_DIR=./data/papers/raw
# paper 索引目录；paper profile 下忽略上面的 PERSIST_DIRECTORY，避免误用课程索引
PAPER_PERSIST_DIRECTORY=./chroma_db_papers
# MinerU 独立 venv（不装进主环境）；支持绝对路径（中文路径失败时可指向 ASCII 盘）
MINERU_PYTHON=./venv-mineru/Scripts/python.exe
MINERU_DEVICE=auto
MINERU_BACKEND=pipeline
MINERU_LANG=ch
MINERU_TIMEOUT=1800
# 模型源：modelscope（默认，实测可用）| huggingface | local
MINERU_MODEL_SOURCE=modelscope
# 批量上传/CLI 的 MinerU 并发上限；1=逐篇解析
PARSE_CONCURRENCY=1
# 论文切分：起点 800 与 CHUNK_SIZE 同口径；M5 做 600/800/1200 A/B 后再改
PAPER_CHUNK_MAX_CHARS=1200
PAPER_CHUNK_MIN_CHARS=200
PAPER_CHUNK_CROSS_PAGE=false
CITATION_LABEL_MODE=page
PAPER_FALLBACK_ENABLED=false
# 演示 profile 省显存时可设：PAPER_EMBEDDING_MODEL=bge-m3-cpu
# 论文库三阈值（M5 实测标定，2026-10-29，1200 字切分，非课程值）：
# 20 域外 + 20 域内 → 域外拒答 95%、域内误拒 0%；held-out 读数见 README/实现记录
PAPER_HARD_REJECT_VECTOR_THRESHOLD=0.40
PAPER_HARD_REJECT_RERANK_THRESHOLD=0.20
PAPER_LOW_CONFIDENCE_THRESHOLD=0.50

# 均字符/页低于此阈值视为无文字层（扫描版），建库时告警跳过而非静默空索引
PDF_MIN_CHARS_PER_PAGE=30

# ===== 混合检索（向量 + BM25 + RRF）=====
HYBRID_ENABLED=true
# 向量通道独立召回数（难 query 正确块常排 30+，池不够捞不到）
RETRIEVE_K=50
# BM25 通道独立召回数（对全库打分，不复用向量候选池）
BM25_TOP_K=50
# RRF 融合后的候选池大小，供精排消费
RERANK_CANDIDATE_K=16

# ===== 重排 Reranker =====
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 精排后进 LLM 的块数。官方评估基线为 top-8 口径，勿随意下调
RERANKER_TOP_N=8
# 枚举类问题的进 LLM 块数（常规走 RERANKER_TOP_N）
ENUM_RERANK_TOP_N=14
# reranker 与模型权重加载需访问 HuggingFace；本机 huggingface.co 不可达会超时卡死，
# 默认走镜像（config.py 已设默认，这里可显式覆盖）
HF_ENDPOINT=https://hf-mirror.com

# ===== 拒答 / 接地自检 =====
# 向量分低于此值判为语料外 → 硬拒答（bge-m3 重标定）
HARD_REJECT_VECTOR_THRESHOLD=0.58
# 精排分低于此值判为语料外 → 硬拒答
HARD_REJECT_RERANK_THRESHOLD=0.30
# fast 模式低置信标记阈值（bge-m3 重标定）
LOW_CONFIDENCE_THRESHOLD=0.62
# 接地自检阈值；未达标记 low_confidence
GROUNDED_SCORE_THRESHOLD=0.60
# 裁判输入上下文上限（字符）。超出会按与回答的相关度裁剪——
# 不裁的话 8 块 ≈ 1 万 token 会撑爆本地裁判 num_ctx=8192（实测 400 → 误判不接地）
GROUNDED_CONTEXT_MAX_CHARS=9000
# 裁判须给逐字 evidence，否则该陈述判不支撑（防 9B 裁判把 0.999 当 0.98 放行）
GROUNDED_REQUIRE_EVIDENCE=true
# 生成后接地复核开关：paper 默认 false、course 默认 true（config.py 按 profile 取默认）。
# paper 关掉的原因：8 GB 卡上 7B 生成 + reranker 已占 7737/8188 MiB，裁判无法同驻；
# 关闭只影响"生成后复核"，检索前硬拒答阈值（0.40/0.20/0.50）照常生效。
# 要显式开启（需本地 glm4:9b，且与生成串行换模型）：GROUNDED_VERIFY_ENABLED=true
# GROUNDED_VERIFY_ENABLED=false

# ===== Query 改写（多轮指代消解）=====
QUERY_REWRITE_ENABLED=true

# ===== 语义缓存 =====
SEMANTIC_CACHE_ENABLED=true
# 命中阈值（embedding 余弦）
SEMANTIC_CACHE_SIM=0.93
# 内存 LRU 容量；多副本部署需换 Redis
SEMANTIC_CACHE_MAX=128

# ===== 裁判（C2 去本地化，2026-10-16）=====
# local  = Ollama 本地独立模型（JUDGE_MODEL 为 Ollama 模型名）
# openai = OpenAI 兼容云端（兼容旧写法 deepseek）；与生成模型必须不同源，避免自评偏差
# 实测（2026-10-16，同一 JSON 接地任务 3 次）：kimi-k2.6 3/3 成功 1.4~1.6s；
# glm-5.2 3/3 但 6.7~24s；qwen3.8-flash 1/3（DNS 失败）→ 默认选 kimi-k2.6。
# 本地裁判候选（2026-10-30 `eval_judge.py` 30 对校准，准确率/误放行）：
#   glm4:9b 0.97/1 > qwen2.5:7b 0.92/1 > qwen2.5:3b 0.87/4；
#   qwen3:4b 的 JSON 只成功 1/30，不能当裁判；llama3.1:8b 误放行 11/60，也不选。
JUDGE_PROVIDER=openai
JUDGE_MODEL=kimi-k2.6
JUDGE_API_BASE=https://kuaipao.pro/v1
# JUDGE_API_KEY=sk-xxxx   # 留空时回退到同一个中转 key（环境变量或 ~/.dsh/.credentials.yaml）
# 裁判默认关闭思维链（推理模型会把预算烧在 reasoning 上导致空 JSON）
JUDGE_DISABLE_THINKING=true
JUDGE_MAX_TOKENS=4096
JUDGE_MAX_TOKENS_CAP=8192
# 本地裁判输出上限：Ollama 路径不设会在重复循环时写满上下文（实测 40960 token / 545s）
JUDGE_LOCAL_MAX_TOKENS=1600
# 本地裁判重复惩罚（glm4:9b 长 JSON 会循环重复 → JSON 截断 → 误判不接地）；
# 1.3 会连判断本身一起带偏（逐字支持的陈述被判 false），实测 1.1 正确且不循环
JUDGE_LOCAL_REPEAT_PENALTY=1.1

# ===== API 服务（FastAPI）=====
# uvicorn 监听端口：由启动命令的 --port 决定，config.py 不读取本变量（设了也不生效）
# 本地启动：uvicorn main:app --host 0.0.0.0 --port 8000
# 数据边界：默认云端生成/裁判会把问题与检索正文发往 API；嵌入不出本机。
# 需要严格「数据不出本机」时，按上方说明切全本地。
# Docker 部署时在 docker-compose.yml 里把 OLLAMA_BASE_URL 指到宿主（host.docker.internal:11434）

# ===== 多用户预留扩展点（默认关闭，需公网暴露时再开）=====
# 开启后所有端点需请求头 X-API-Key: <API_KEY>
AUTH_ENABLED=false
API_KEY=
# 每 IP 每分钟请求上限，0=不限
RATE_LIMIT=0
# 生产环境收紧跨域，填具体域名
CORS_ORIGINS=*
# /documents 上传大小上限（MB），超限返回 413
MAX_UPLOAD_MB=100
